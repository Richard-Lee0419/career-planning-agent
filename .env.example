ZHIPUAI_API_KEY=replace-with-your-api-key
JWT_SECRET_KEY=
# 单次模型请求超时（秒）和 SDK 自动重试次数；可按部署环境调整
AI_REQUEST_TIMEOUT_SECONDS=30
AI_VOICE_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=1
# 可选：主文本模型遇到连接、超时或 5xx 后尝试一次备用模型；留空则不调用备用模型
ZHIPUAI_FALLBACK_MODEL=
# 可选：隔离演示数据库路径；相对路径以仓库根目录为基准。
# 不设置时仍使用 data/career_project.db。演示与验证建议使用独立 *.db 文件。
CAREER_DATABASE_PATH=
